set(AMDVA_ORT_ROOT "$ENV{VIRTUAL_ENV}/onnxruntime" CACHE PATH "Ryzen AI ONNX Runtime SDK root")
find_path(AMDVA_ORT_INCLUDE onnxruntime_cxx_api.h HINTS "${AMDVA_ORT_ROOT}/include/onnxruntime" REQUIRED)
find_library(AMDVA_ORT_LIBRARY NAMES onnxruntime HINTS "${AMDVA_ORT_ROOT}/lib" REQUIRED NO_DEFAULT_PATH)
add_library(amdva_npu SHARED src/npu.cpp)
add_library(AMDVA::amdva_npu ALIAS amdva_npu)
target_include_directories(amdva_npu PRIVATE "${AMDVA_ORT_INCLUDE}")
target_link_libraries(amdva_npu PUBLIC amdva_runtime PRIVATE "${AMDVA_ORT_LIBRARY}")
target_compile_options(amdva_npu PRIVATE -Wall -Wextra)
set_target_properties(amdva_npu PROPERTIES INSTALL_RPATH "${AMDVA_ORT_ROOT}/lib")
install(TARGETS amdva_npu EXPORT AMDVideoAnalyticsTargets LIBRARY DESTINATION lib)
